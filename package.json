{
  "name": "codesentry",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/semgrep-rules"
  ],
  "type": "module",
  "description": "CLI de verificação de vulnerabilidades e qualidade de código",
  "bin": {
    "codesentry": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --shims",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:owasp-rules": "node scripts/prepare-owasp-rules.mjs"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/parser": "^7.29.8",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "codesentry-semgrep-rules": "0.1.0",
    "commander": "^15.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "figlet": "^1.11.4",
    "gradient-string": "^3.0.0",
    "listr2": "^11.1.0",
    "p-limit": "^7.3.2"
  },
  "optionalDependencies": {
    "codesentry-semgrep-linux-x64": "0.1.0",
    "codesentry-semgrep-win32-x64": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}

{
  "name": "codesentry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI de verificação de vulnerabilidades e qualidade de código",
  "bin": {
    "codesentry": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --shims",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "figlet": "^1.11.4",
    "gradient-string": "^3.0.0",
    "listr2": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
